# Rohdaten — zu groß für GitHub (86 CSV-Dateien, bis 911 MB)
# Ausnahme: die Dateien, die das Dashboard tatsächlich braucht
Data/*
!Data/analysetabelle.csv
!Data/modell_krankenhaus.pkl
Aufgabenstellung/*
!Aufgabenstellung/Fragestellung.docx
!Aufgabenstellung/Fragestellung.md

# Python-Cache
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Projekteigene virtuelle Umgebung (siehe README: `python -m venv .venv`)
.venv/

# Skript-Ordner komplett von Commits ausschließen
scripts/

# ZIP-Dateien nicht einchecken
*.zip

# TXT-Dateien nicht einchecken (Ausnahme: requirements.txt wird für pip install gebraucht)
*.txt
!requirements.txt

# PowerPoint-Dateien nicht einchecken
*.ppt
*.pptx

# Präsentations-Ordner von Commits ausschließen — außer explizit eingecheckte Dateien
Docs/PPT/*
!Docs/PPT/Projektbegleitende_Praesentation.pptx
Docs/MD/Praesentation_Folien_Beschreibung.md
Docs/MD/Praesentation_Team_Folien_Beschreibung.md

# Jupyter-Outputs optional ausschließen (auskommentieren um Outputs zu behalten)
# *.ipynb

# Externe Quellberichte (PDF) nicht einchecken
Docs/IQTIG_Bericht-zum-Strukturierten-Dialog-2021_EJ-2020_2022-05-16-barrierefrei.pdf
Docs/IQTIG_Bundesqualitaetsbericht-2023_2023-11-08.pdf

# GitHub-Codespaces-Konfiguration nicht einchecken (nicht genutzt, Deployment läuft über Streamlit Cloud)
.devcontainer/

# Persönliches Archiv der Nutzerin — rein manuell gepflegt, nicht versionieren
Docs/Archiv/

# Lokale Server-Log-Dateien (z. B. beim Neustarten von streamlit run entstanden)
*.log
