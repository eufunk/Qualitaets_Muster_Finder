__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Projekteigene virtuelle Umgebung (siehe README: `python -m venv .venv`)
.venv/

# Skript-Ordner komplett von Commits ausschließen
scripts/

# ZIP-Dateien nicht einchecken
*.zip

# TXT-Dateien nicht einchecken (Ausnahme: requirements.txt wird für pip install gebraucht)
*.txt
!requirements.txt

# PowerPoint-Dateien nicht einchecken
*.ppt
*.pptx

